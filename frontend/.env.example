# Where the frontend sends API requests.
#   Development: leave as /api — Vite forwards it to the backend (see vite.config.js).
#   Production:  the deployed backend, e.g. https://skill-bridge-api.vercel.app/api
VITE_API_URL=/api

# Development only: where the Vite proxy forwards /api (default http://localhost:4000)
# BACKEND_URL=http://localhost:4000
