# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillbridge?schema=public"
# Optional: separate connection for migrations (Neon: the non-pooled URL). Falls back to DATABASE_URL.
# DIRECT_URL=""

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Used in email links (reset password, verify email, notifications)
FRONTEND_URL="http://localhost:5173"
# Allowed browser origins, comma-separated. "*" works inside a host for preview URLs:
#   CORS_ORIGINS="https://skill-bridge.vercel.app,https://skill-bridge-*.vercel.app"
CORS_ORIGINS="http://localhost:5173"

# ---------------------------------------------------------------------------
# Email (SMTP). Leave empty in development: emails are printed in the terminal instead.
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords), then:
#   SMTP_HOST="smtp.gmail.com"  SMTP_PORT="465"  SMTP_USER="you@gmail.com"  SMTP_PASS="the 16-letter app password"
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Skill Bridge <no-reply@example.com>"
# Set to "false" to stop emailing notifications (password/verification emails are still sent)
EMAIL_NOTIFICATIONS="true"

# ---------------------------------------------------------------------------
# Uploads (stored in the database). Keep ≤ 4 on Vercel, which limits request bodies to 4.5 MB.
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB="4"
